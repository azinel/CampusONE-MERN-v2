# Mandatory Security Secrets
ACCESS_TOKEN_SECRET=campusone_access_secret_example
REFRESH_TOKEN_SECRET=campusone_refresh_secret_example
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=7d

# Server & Database Configuration
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/campusone
NODE_ENV=development

# CORS Configuration
# Comma-separated list of allowed frontend origins in production (e.g., https://campusone.example.com)
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Redis & BullMQ Queue Configuration
# Redis connection URL for caching and BullMQ notification queues (default: redis://127.0.0.1:6379).
# Supports rediss:// for cloud Redis providers with TLS (e.g., Upstash, Render, AWS ElastiCache).
# If Redis is unavailable, the application gracefully fails open and continues serving requests without blocking or crashing.
REDIS_URL=redis://127.0.0.1:6379

# Cloudinary Storage Configuration (Optional - image uploads fall back safely when unset)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
